<Group view="code" hide-input="false" labelreference="L6" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># Reference frames definition 

Rz10 := Rz(q1(t)):
Rz21 := Rz(q2(t)):
F10 := TM(Rz10,&lt;0,0,0&gt;):
F21 := TM(Rz21,&lt;L__1,0,0&gt;):
F20 := simplify(F10.F21):


# kinematics 

r1 := (F10.&lt;COM__1,0,0,1&gt;)(1..3):  # extract the position of the COM with the built-in parser tool in Python script   
r2 := (F20.&lt;COM__2,0,0,1&gt;)(1..3):

v1 := diff(r1,t):
v2 := diff(r2,t):

a1 := diff(v1,t):
a2 := diff(v2,t):

# weight forces 

w1 := m1*&lt;0,-g,0&gt;:
w2 := m2*&lt;0,-g,0&gt;:


# Energy 

T1 := 1/2*m1*Transpose(v1).v1 + 1/2 * J1 * diff(q1(t),t)^2:
T2 := 1/2*m2*Transpose(v2).v2 + 1/2 * J2 * diff(q2(t),t)^2:

V1 := -Transpose(w1).r1:
V2 := -Transpose(w2).r2:

Ttot := T1+T2:
Vtot := V1+V2:

# Dynamics through Lagrange Equations --&gt; handy since it generates the least amount of equations for local parametrizing generalized coordinates compared to Newton-Euler approach 

q := [q1(t),q2(t)];

L_eqns := LagrangeEqs(Ttot,Vtot,q);


eq_sys := [L_eqns[1] = tau1-b1*diff(q1(t),t),L_eqns[2]=tau2-b2*diff(q2(t),t)];

</Text-field>
</Input>
