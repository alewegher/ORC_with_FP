<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">state := [op(q),op(diff(q,t))]:
eq_der := [
diff(q1(t),t) = dq1(t),
diff(q2(t),t) = dq2(t)
]:

eq_motion := [op(eq_der),op(subs(eq_der,eq_sys))];

velx := [dq1(t),dq2(t)]:

dstate := [op(velx),op(diff(velx,t))];


A,b := GenerateMatrix(eq_motion,dstate);

r = Rank(A);</Text-field>
