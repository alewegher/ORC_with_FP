<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">Rz := proc(theta::function)::Matrix:
    
      local Rz_mat;
       
      Rz_mat := Matrix([[cos(theta),-sin(theta),0],[sin(theta),cos(theta),0],[0,0,0]]):

      return Rz_mat;      
      end proc:

Rzz:= Rz(theta__1(t)); # prova 


TM := proc(Rz::Matrix,x0::Vector):
   
      local TM; 

      TM := Matrix([[op(convert(Rz(1,1..3),list)),x0(1)],[op(convert(Rz(2,1..3),list)),x0(2)],[op(convert(Rz(3,1..3),list)),x0(3)],[0,0,0,1]]):

      return TM;

      end proc:


TF := TM(Rzz,&lt;2,0,3&gt;); # prova 


diffF := proc(L,q::function):

local xx,dL,dLf,Lf;

Lf := subs(q=xx,L);

dL := diff(Lf,xx);

dLf := subs(xx=q,dL);

return dLf;

end proc:


JacobianF := proc(L::Vector, q::list)
    local J, N, M, i, j;

    M := RowDimension(L):         # numero di righe
    N := nops(q):           # numero di variabili

    J := Matrix(M, N):      # inizializza matrice Jacobiana

    for i from 1 to M do
        for j from 1 to N do
            J[i,j] := diffF(L[i], q[j]);  # usa diffF per derivata composita
        end do:
    end do:
  return J;
end proc:

q := [q1(t),q2(t)]:
F := &lt;cos(q1(t)),cos(q2(t))&gt;:

Jf := JacobianF(F,q);
</Text-field>
</Input>
<Input><Text-field prompt="&gt; " style="Maple Input" spaceabove="0" linebreak="space" rightmargin="0" linespacing="0.0" initial="0" firstindent="0" leftmargin="0" bulletsuffix="" alignment="left" bullet="none" spacebelow="0" pagebreak-before="false">LagrangeEqs := proc(T, V, q::list)
    local n, i, qd, dT_dqd, ddt_dT_dqd, dT_dq, dV_dq, Lags;

    n := nops(q);                     # numero di coordinate generalizzate
<Font encoding="UTF-8">    qd := diff(q,t);                  # derivate q\314\207
</Font>
    Lags := [];                       # inizializza lista delle eq. di Lagrange

    for i from 1 to n do
<Font encoding="UTF-8">        dT_dqd := diffF(T, qd[i]);                             # \342\210\202T/\342\210\202q\314\207_i
        ddt_dT_dqd := diff(dT_dqd, t);                        # d/dt(\342\210\202T/\342\210\202q\314\207_i)
        dT_dq := diffF(T, q[i]);                               # \342\210\202T/\342\210\202q_i
        dV_dq := diffF(V, q[i]);                               # \342\210\202V/\342\210\202q_i
</Font>
        Lags := [op(Lags), simplify(ddt_dT_dqd - dT_dq + dV_dq)];  # eq. i
    end do:

    return Vector(Lags);              # restituisci sistema in forma vettoriale
end proc:

q := [q1(t), q2(t)]:
# Esempio fittizio per T e V
T := 1/2*m*(diff(q1(t),t))^2 + 1/2*m*(diff(q2(t),t))^2 + m*diff(q1(t),t)*diff(q2(t),t);
whattype(T);
V := m*g*q1(t) + m*g*q2(t):

L := LagrangeEqs(T, V, q);

whattype(L);

# Output: sistema simbolico in funzione di q1(t), q2(t), e le derivate
</Text-field>
</Input>
