    // --- CONFIGURAZIONE PER "Banner comments" (heyimfuzz) ---
    // Questi comandi definiscono i font per i comandi rapidi h1, h2, h3.
    "banner-comments.h1": "Letters",
    "banner-comments.h2": "Small Slant",
    "banner-comments.h3": "Ogre",
    
    // Usiamo il font "Terrace" (il tuo vecchio "title") nei preferiti.
    // Lo richiamerai tramite la Command Palette.
    "banner-comments.favorites": [
        "Terrace"
    ],

    // Impostazioni per il wrap automatico e la larghezza.
    "banner-comments.figlet.whitespaceBreak": true,
    "banner-comments.figlet.width": 80,
    
